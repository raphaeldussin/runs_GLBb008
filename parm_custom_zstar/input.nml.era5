  &MOM_input_nml
          output_directory = './',
          input_filename = 'n'
          restart_input_dir = 'INPUT/',
          restart_output_dir = 'RESTART/',
          parameter_filename = 'INPUT/MOM_input','INPUT/MOM_layout','INPUT/MOM_override'
 /
 
  &SIS_input_nml
          output_directory = './',
          input_filename  = 'r'
          restart_input_dir = 'INPUT/',
          restart_output_dir = 'RESTART/',
          parameter_filename = 'INPUT/SIS_input','INPUT/SIS_layout','INPUT/SIS_override'
 /
 
  &atmos_model_nml
  layout = 1,1
 /
 
  &data_override_nml
        use_data_table_yaml = .false.
 /

  &coupler_nml
         months = 1,
         days   = 0,
         current_date = 2020,1,1,0,0,0,
         calendar = 'julian',
         dt_atmos =1200,
         dt_cpld = 1200,
         use_lag_fluxes=.false.
         concurrent = .false.
         do_ocean = .true.,
         ocean_npes = 0,
         atmos_npes = 0,
         do_atmos = .false.,
         do_land = .false.,
         do_ice = .true.,
         concurrent_ice=.false.
         slow_ice_with_ocean = .false.
         combined_ice_and_ocean = .false.
         atmos_nthreads = 1
         ocean_nthreads = 1
         check_stocks=0
 /
 
  &diag_manager_nml
         max_files = 100
         flush_nc_files=.false.
         max_axes = 100
         max_num_axis_sets = 100
         max_input_fields = 699
         max_output_fields = 699
         mix_snapshot_average_fields=.false.
         issue_oor_warnings=.false.
 /
 
  &flux_exchange_nml
        debug_stocks = .FALSE.
        divert_stocks_report = .TRUE.
        do_area_weighted_flux = .FALSE.
        partition_fprec_from_lprec = .false.
 /
 
  &fms_io_nml
         threading_read  = 'multi',
         max_files_r = 100,
         max_files_w = 100,
         checksum_required =.false.
 /
 
  &fms_nml
         clock_grain='ROUTINE'
         clock_flags='NONE'
         domains_stack_size = 8000000
         stack_size =0
 /
 
  &ice_albedo_nml
             t_range = 10.
 /
 
  &icebergs_nml
         verbose=.false.
         verbose_hrs=24
         traj_sample_hrs=24
         debug=.false.
         really_debug=.false.
         use_operator_splitting=.TRUE.
         bergy_bit_erosion_fraction=0.0
         sicn_shift=0.1
         parallel_reprod=.TRUE.
         use_slow_find=.true.
         add_weight_to_ocean=.false.
         passive_mode=.false.
         generate_test_icebergs=.false.
         speed_limit=0.
         use_roundoff_fix=.true.
         make_calving_reproduce=.true.
         tidal_drift=0.005
         coastal_drift=0.001
         mass_scaling = 4000,400,100,40,20,10,4,2,2,2
         force_all_pes_traj=.true.
 /
 
  &monin_obukhov_nml
         neutral = .true.,
 /
 
  &ocean_albedo_nml
         ocean_albedo_option = 2
 /
 
  &ocean_rough_nml
         rough_scheme = 'beljaars'
         roughness_min = 1.e-4
 /
 
  &sat_vapor_pres_nml
         construct_table_wrt_liq = .true.
         construct_table_wrt_liq_and_ice = .true.
 /
 
  &surface_flux_nml
         gust_min = 1.e-10
         ncar_ocean_flux_multilevel = .true.
         bulk_zu = 10.
         bulk_zt = 2.
         bulk_zq = 2.
         raoult_sat_vap = .true.
 /
 
  &time_interp_external_nml
         num_io_buffers=24
 /
 
  &xgrid_nml
         make_exchange_reproduce = .false.
         interp_method = 'second_order'
 /
