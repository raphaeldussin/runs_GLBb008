#!/bin/bash -l
#
#SBATCH --mail-user=Raphael.Dussin@noaa.gov
#SBATCH --mail-type=END,FAIL
# -- Request that this job run on orion
#SBATCH --partition=orion
#
# -- Request 2119 cores
#SBATCH --ntasks=2119
#
# -- Specify a maximum wallclock of 4 hours
#SBATCH --time=4:30:00
#
# -- Specify under which account a job should run
#SBATCH --account=marine-cpu
#
# -- Set the name of the job, or Slurm will default to the name of the script
#SBATCH --job-name=GLBb008
#
# -- Tell the batch system to set the working directory to the current working directory
#SBATCH --chdir=.

# number of jobs to run:
njobs=36
# state of the run (i.e. date)
STATE_FILE="state.txt"
# forcing variables to subset

# --------------------------------------------------------------------------------
# setup the run directory
# --------------------------------------------------------------------------------

if [ ! -d INPUT ] ; then mkdir INPUT ; fi
if [ ! -d RESTART ] ; then mkdir RESTART ; fi
if [ ! -d outputs_raw ] ; then mkdir outputs_raw ; fi
if [ ! -d restarts_raw ] ; then mkdir restarts_raw ; fi
if [ ! -d logs ] ; then mkdir logs ; fi

# copy executable and input files
cp /work/noaa/marine/rdussin/MOM6-examples/build/intel/ice_ocean_SIS2/repro/MOM6 .
cp /work/noaa/marine/rdussin/MOM6-examples/env.sh .

# copy namelists
cp /work/noaa/marine/rdussin/RTOFS_GLO/parm/diag_table .
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/data_table.JRA55do ./data_table
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/field_table .
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/diag_table .
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/MOM_{input,override} ./INPUT/.
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/input.nml.jra55 ./input.nml
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/SIS_{input,override} ./INPUT/.

# layout and mask_table
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/mask_table.793.56x52 ./INPUT/.
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/MOM_layout.793.56x52 ./INPUT/MOM_layout
cp /work/noaa/marine/rdussin/runs_mom6/parm_custom/SIS_layout.793.56x52 ./INPUT/SIS_layout

# grid, topo and other fixed files
ln -sf /work/noaa/marine/rdussin/datasets/RTOFS3/fix/mom6/20250128/008/*.nc INPUT/.
cp INPUT/ocean_topog.nc INPUT/topog.nc


# setup environment/system
source env.sh
module load nco
ulimit -s unlimited
export NC_BLKSZ=1M

# --------------------------------------------------------------------------------
# functions for interannual forcing
# --------------------------------------------------------------------------------

is_leap_year() {
    local y=$1
    if (( (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0) )); then
        echo 1
    else
        echo 0
    fi
}

get_days_in_month() {
    local y=$1
    local m=$2
    local days=(0 31 28 31 30 31 30 31 31 30 31 30 31)

    if [[ $m -eq 2 ]]; then
        local leap=$(is_leap_year "$y")
        if [[ $leap -eq 1 ]]; then
            echo 29
        else
            echo 28
        fi
    else
        echo "${days[$m]}"
    fi
}


ctrldir=$( pwd )
subscript=mom.sub

# --------------------------------------------------------------------------------
# Control the looping for jobs

if [ ! -f jobscompleted ] ; then touch jobscompleted ; fi

lastjob=$( tail -1 jobscompleted )
thisjob=$(( $lastjob + 1 )) # if file empty, takes job number one

echo 'starting job #' $thisjob

# at first job, replace restart by cold start and set up state file
if [[ $thisjob == 1 ]] ; then
   sed -i -e "s/input_filename = 'r'/input_filename = 'n'/g" input.nml
   yearbeg=$( grep "current_date" input.nml | sed -e "s/,/ /g" | awk '{print $3}' )
   echo "$yearbeg 01" | cat > $STATE_FILE
# at second job, replace init by restart
elif [[ $thisjob != 1 ]] ; then
   sed -i -e "s/input_filename = 'n'/input_filename = 'r'/g" input.nml
fi


if [[ $thisjob == 1 ]] ; then
  # IC from Matt's JRA run
  ln -sf /work/noaa/marine/rdussin/datasets/ICs/ocean_MOM6_GLBc008_Matt_Jan2020/remap_RTOFS3/ocean_init_202001_MOM6_1x1deg.nc ./INPUT/.
  ln -sf /work/noaa/marine/rdussin/datasets/ICs/seaice_SIS2_Matt_Jan2020_restart/*.nc ./INPUT/.
fi

# forcing
read -r YYYY MM < "$STATE_FILE"

YEAR=$((10#$YYYY))
MONTH=$((10#$MM))
MM_STR=$(printf "%02d" "$MONTH")

pushd INPUT
# atmospheric forcing, TODO update year for interannual run
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/huss_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010000-${YEAR}12312100.padded.nc JRA_huss.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/prra_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010130-${YEAR}12312230.padded.nc JRA_prra.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/prsn_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010130-${YEAR}12312230.padded.nc JRA_prsn.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/psl_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010000-${YEAR}12312100.padded.nc  JRA_psl.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/rlds_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010130-${YEAR}12312230.padded.nc JRA_rlds.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/rsds_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010130-${YEAR}12312230.padded.nc JRA_rsds.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/tas_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010000-${YEAR}12312100.padded.nc  JRA_tas.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/uas_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010000-${YEAR}12312100.padded.nc  JRA_uas.nc
ln -sf /work/noaa/marine/rdussin/datasets/JRA55do_v1.5.0/vas_input4MIPs_atmosphericState_OMIP_MRI-JRA55-do-1-5-0-1_gr_${YEAR}01010000-${YEAR}12312100.padded.nc  JRA_vas.nc
popd

# Run the model

srun -n $SLURM_NTASKS ./MOM6 > fms.out 2>&1

runok=$( tail -200 fms.out | grep -i "Total runtime" )
if [[ $runok != '' ]] ; then
   # move outputs
   mv *.nc ./outputs_raw/.
   mv *.nc.???? ./outputs_raw/.
   # initiate transfer
   #sbatch transfer.sub $thisyear
   # save restarts and update links in INPUT
   mkdir -p ./restarts_raw/restarts.$thisjob
   mv RESTART/* ./restarts_raw/restarts.$thisjob/.
   ln -sf ${ctrldir}/restarts_raw/restarts.$thisjob/* ./INPUT/.
   # move logs
   tar -cvf logs.tar.$thisjob *_parameter_doc.* fms.out *.stats logfile.* available_diags.000000 SIS.available_diags SIS_fast.available_diags diag_table data_table* field_table time_stamp.out warnfile.000000.out
   mv logs.tar.$thisjob ./logs/.
   rm *_parameter_doc.* fms.out *.stats logfile.* available_diags.000000 SIS.available_diags SIS_fast.available_diags diag_table data_table* field_table time_stamp.out warnfile.000000.out

   # notify completion
   echo $thisjob >> $ctrldir/jobscompleted
   # test for resubmission
   if (( $thisjob < $njobs )) ; then
      cd $ctrldir ; sbatch ./$subscript
   else
      # final job
      echo this is the last job
   fi
   # update state file
   NEXT_MONTH=$(( MONTH + 1 ))
   NEXT_YEAR=$YEAR
    
   if [[ $NEXT_MONTH -gt 12 ]]; then
       NEXT_MONTH=1
       NEXT_YEAR=$(( YEAR + 1 ))
   fi
    
   NEXT_MM_STR=$(printf "%02d" "$NEXT_MONTH")
    
   echo "$NEXT_YEAR $NEXT_MM_STR" > "$STATE_FILE"
   echo "Updated $STATE_FILE to the next run: $NEXT_YEAR $NEXT_MM_STR"
else
   # run blew up
   echo "run blew up"
   exit 1
fi
